  // ============================================================
  // KANVAS RENDER LOOP
  // ============================================================
  function render(ts) {
    if (!S.lastFrame) S.lastFrame = ts;
    const dt = Math.min(0.05, (ts - S.lastFrame) / 1000) || 0.016;
    S.lastFrame = ts;

    // --- 500 ms da analiz ---
    if (ts - S.ppg.lastAnalyze > 500) {
      S.ppg.lastAnalyze = ts;
      if (S.camActive) {
        const s = readCameraSample(ts);
        if (s) {
          S.ppg.samples.push(s);
          const buf = S.ppg.samples;
          while (buf.length && ts - buf[0].t > 10000) buf.shift();
          analyzePPG();
        }
      }
    }

    if (S.motionActive && ts - S.motion.lastAnalyze > 500) {
      S.motion.lastAnalyze = ts;
      analyzeMotion();
    }

    // --- Faol BPM manbai ---
    if (S.camActive && S.ppg.bpm > 40 && S.ppg.quality > 30) {
      S.activeBpm = S.ppg.bpm;
      S.activeBpmSrc = 'real';
    } else {
      S.activeBpm = S.bpmManual;
      S.activeBpmSrc = 'sim';
    }
    S.activeResp = S.motionActive ? S.motion.resp : 0;
    S.activeRespSrc = (S.motionActive && S.motion.resp > 0) ? 'real' : '--';

    // --- Kritik holat ---
    const isCrit = (
      S.k >= 6.0 || S.k <= 2.8 ||
      S.glu >= 20.0 || S.glu <= 2.5 ||
      S.activeBpm >= 135
    );

    monBox.style.borderColor = isCrit ? '#ff0055' : '#00f5d4';

    // --- Fon ---
    ctx.fillStyle = isCrit ? '#14040a' : '#050912';
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = isCrit ? 'rgba(255,0,85,0.12)' : 'rgba(0,245,212,0.09)';
    ctx.lineWidth = 1;
    for (let x = 0; x < W; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (let y = 0; y < H; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

    // --- Waveform buferlarini siljitish ---
    const step = 6;
    for (let i = 0; i < W - step; i++) {
      S.ecg[i] = S.ecg[i + step];
      S.ppgBuf[i] = S.ppgBuf[i + step];
      S.accBuf[i] = S.accBuf[i + step];
    }

    // --- Yangi namunalar ---
    const freq = S.activeBpm / 60;
    const dPhase = freq * dt / step;
    const camVal = S.camActive && S.ppg.samples.length > 0
      ? (S.ppg.samples[S.ppg.samples.length-1].perfusion)
      : 0;

    // Kamera qiymatini [-1, 1] ga normallashtirish (taxminiy)
    let ppgNorm = 0;
    if (S.camActive && S.ppg.samples.length > 30) {
      const recent = S.ppg.samples.slice(-60).map(s => s.perfusion);
      const m = U.mean(recent);
      const sd = U.std(recent) || 1;
      const z = (camVal - m) / (sd * 2.5);
      ppgNorm = U.clamp(z, -1, 1);
    }

    // Accelerometr
    let accNorm = 0;
    if (S.motionActive && S.motion.samples.length > 0) {
      const last = S.motion.samples.slice(-60).map(s => s.mag);
      const m = U.mean(last);
      const sd = U.std(last) || 1;
      const cur = S.motion.samples[S.motion.samples.length-1].mag;
      accNorm = U.clamp((cur - m) / (sd * 3), -1, 1);
    }

    for (let j = 0; j < step; j++) {
      S.prevPhase = S.phase;
      S.phase = (S.phase + dPhase) % 1;
      if (S.prevPhase < 0.40 && S.phase >= 0.40) beep(isCrit);
      const noise = (Math.random() - 0.5) * (isCrit ? 0.04 : 0.01);
      S.ecg[W - step + j] = computeEcg(S.phase, S.k) + noise;
      S.ppgBuf[W - step + j] = S.camActive ? ppgNorm : computePleth(S.phase);
      S.accBuf[W - step + j] = S.motionActive ? accNorm : 0;
    }

    // --- HUD ---
    ctx.fillStyle = 'rgba(15,23,42,0.94)';
    ctx.fillRect(20, 18, W - 40, 145);
    ctx.strokeStyle = isCrit ? '#ff0055' : '#00f5d4';
    ctx.lineWidth = 2.5;
    ctx.strokeRect(20, 18, W - 40, 145);

    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 20px monospace';
    ctx.fillText('TIBEX ICU · REAL SENSOR FUSION', 38, 48);

    // Tashxis
    ctx.font = 'bold 16px monospace';
    ctx.fillStyle = isCrit ? '#ff0055' : '#00f5d4';
    let diag = 'SINUS RITMI (NORMA)';
    if (S.k >= 6.0) diag = 'GIPERKALIYEMIYA';
    else if (S.k <= 2.8) diag = 'GIPOKALIYEMIYA';
    else if (S.glu >= 20.0) diag = 'DKA XAVFI';
    else if (S.glu <= 2.5) diag = 'GIPOGLIKEMIK KOMA';
    else if (S.activeBpm >= 135) diag = 'TAXIKARDIYA';
    ctx.fillText('TASHXIS: ' + diag, 38, 78);

    // Real va Sim ko'rsatkichlari
    // HR
    const hrColor = S.activeBpmSrc === 'real' ? '#22c55e' : '#94a3b8';
    ctx.fillStyle = hrColor;
    ctx.font = 'bold 18px monospace';
    const hrTag = S.activeBpmSrc === 'real' ? '[REAL]' : '[SIM]';
    ctx.fillText('HR: ' + S.activeBpm + ' BPM ' + hrTag, 38, 105);

    // Resp
    const respColor = S.activeRespSrc === 'real' ? '#22c55e' : '#94a3b8';
    ctx.fillStyle = respColor;
    ctx.font = 'bold 16px monospace';
    const respTag = S.activeRespSrc === 'real' ? '[REAL]' : '[--]';
    ctx.fillText('Nafas: ' + (S.activeResp || '--') + '/min ' + respTag, 380, 105);

    // K⁺ va Glu
    ctx.font = 'bold 15px monospace';
    ctx.fillStyle = (S.k >= 6.0 || S.k <= 2.8) ? '#ff0055' : '#00f5d4';
    ctx.fillText('K⁺: ' + S.k.toFixed(1) + ' mmol/L', 38, 135);
    ctx.fillStyle = (S.glu >= 20.0 || S.glu <= 2.5) ? '#ff0055' : '#38bdf8';
    ctx.fillText('GLU: ' + S.glu.toFixed(1) + ' mmol/L', 380, 135);

    // --- EKG ---
    const ecgY = 380;
    const mainCol = isCrit ? '#ff0055' : '#00f5d4';
    ctx.save();
    ctx.beginPath();
    for (let x = 0; x < W; x++) {
      const y = ecgY - S.ecg[x] * 165;
      if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.shadowColor = mainCol;
    ctx.shadowBlur = 16;
    ctx.strokeStyle = mainCol;
    ctx.lineWidth = 4;
    ctx.stroke();
    ctx.restore();

    // --- PPG ---
    const ppgY = 530;
    const ppgCol = S.camActive ? '#f43f5e' : '#38bdf8';
    ctx.save();
    ctx.beginPath();
    for (let x = 0; x < W; x++) {
      const y = ppgY - S.ppgBuf[x] * 85;
      if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.shadowColor = ppgCol;
    ctx.shadowBlur = 12;
    ctx.strokeStyle = ppgCol;
    ctx.lineWidth = 3.5;
    ctx.stroke();
    ctx.restore();

    // --- Akselerometr (pastda, ingichka) ---
    const accY = 620;
    const accCol = S.motionActive ? '#a78bfa' : '#334155';
    ctx.save();
    ctx.beginPath();
    for (let x = 0; x < W; x++) {
      const y = accY - S.accBuf[x] * 25;
      if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = accCol;
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.restore();

    // Kanal yorliqlari
    ctx.fillStyle = '#94a3b8';
    ctx.font = 'bold 14px monospace';
    ctx.fillText('I-KANAL: EKG Lead II', 26, 195);
    ctx.fillText(S.camActive ? 'II-KANAL: KAMERA PPG (REAL)' : 'II-KANAL: SpO2 PLETH', 26, 440);
    ctx.fillStyle = S.motionActive ? '#a78bfa' : '#475569';
    ctx.fillText('III-KANAL: AKSELEROMETR (nafas)', 26, 605);

    // Pastki imzo
    ctx.fillStyle = '#facc15';
    ctx.font = 'bold 18px monospace';
    ctx.fillText('> Burishtirma aftingni, texnika bu!', 26, 660);

    // --- Kamera sifat ko'rsatkichi ---
    if (S.camActive) {
      camQualityL.textContent = S.ppg.quality > 0
        ? (S.ppg.quality > 60 ? '✓ Yaxshi signal' : (S.ppg.quality > 30 ? '~ O\'rtacha signal' : '✗ Barmoqni qimirlatmang'))
        : 'Barmoqni kameraga bosing';
      camQualityR.textContent = 'SQI: ' + S.ppg.quality + '%';
    }

    // --- Bildirishnoma (kritik holat) ---
    if (isCrit && 'Notification' in window && Notification.permission === 'granted' && ts - S.notifLast > 15000) {
      S.notifLast = ts;
      try {
        new Notification('🚨 TIBEX ICU: KRITIK HOLAT', {
          body: 'K⁺=' + S.k.toFixed(1) + '  GLU=' + S.glu.toFixed(1) + '  HR=' + S.activeBpm,
          tag: 'tibex-crit'
        });
      } catch (e) {}
    }

    requestAnimationFrame(render);
  }

  // ============================================================
  // VIDEO YOZISH
  // ============================================================
  function pickMime() {
    if (typeof MediaRecorder === 'undefined') return '';
    const list = ['video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus',
                  'video/webm;codecs=vp9', 'video/webm;codecs=vp8',
                  'video/webm', 'video/mp4'];
    for (const m of list) {
      if (MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(m)) return m;
    }
    return '';
  }

  async function recordVideo() {
    if (typeof canvas.captureStream !== 'function' || typeof MediaRecorder === 'undefined') {
      log('⚠️ Bu brauzerda video yozish mavjud emas.');
      return;
    }
    if (!S.soundOn) initAudio();

    btnRec.disabled = true;
    btnRec.textContent = '🔴 YOZILMOQDA...';
    log('🎬 6 soniya. Slayderlarni o\'ynating!');

    const vStream = canvas.captureStream(60);
    const tracks = [...vStream.getVideoTracks()];

    if (S.streamDest && S.streamDest.stream.getAudioTracks().length > 0) {
      tracks.push(...S.streamDest.stream.getAudioTracks());
    }
    if (S.micStream && S.micStream.getAudioTracks().length > 0) {
      tracks.push(...S.micStream.getAudioTracks());
    }

    const mime = pickMime();
    let rec;
    try {
      rec = new MediaRecorder(new MediaStream(tracks), mime ? { mimeType: mime } : undefined);
    } catch (e) {
      log('⚠️ MediaRecorder: ' + e.message);
      btnRec.disabled = false;
      btnRec.textContent = '🎬 6s Video';
      return;
    }

    const chunks = [];
    rec.ondataavailable = e => { if (e.data && e.data.size > 0) chunks.push(e.data); };
    rec.onstop = () => {
      const ext = mime.indexOf('mp4') >= 0 ? 'mp4' : 'webm';
      const blob = new Blob(chunks, { type: mime || 'video/webm' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'TIBEX_ICU_' + Date.now() + '.' + ext;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      btnRec.disabled = false;
      btnRec.textContent = '🎬 6s Video';
      log('✅ Video yuklandi (' + (blob.size/1024).toFixed(0) + ' KB).');
    };

    rec.start();
    setTimeout(() => { if (rec.state === 'recording') rec.stop(); }, 6000);
  }

