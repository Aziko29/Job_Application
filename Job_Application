<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>TIBEX ICU v3.0 — Real Sensor Fusion</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; }
  html, body { background: #04070d; color: #f1f5f9; font-family: ui-monospace, 'Courier New', monospace; padding: 8px; min-height: 100vh; -webkit-font-smoothing: antialiased; }
  body { display: flex; flex-direction: column; align-items: center; gap: 8px; }

  .card { width: 100%; max-width: 440px; background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 10px; }
  .card-title { font-size: 10px; font-weight: 700; color: #64748b; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 8px; }

  .monitor-box { width: 100%; max-width: 440px; background: #070c16; border: 2px solid #00f5d4; border-radius: 14px; overflow: hidden; box-shadow: 0 0 25px rgba(0,245,212,0.18); transition: border-color 0.25s; }
  canvas { width: 100%; height: auto; display: block; background: #050811; }

  /* Ruxsat qatorlari */
  .perm-row { display: flex; align-items: center; justify-content: space-between; padding: 9px 4px; font-size: 12px; border-bottom: 1px solid #1e293b; gap: 8px; }
  .perm-row:last-child { border-bottom: none; }
  .perm-label { display: flex; align-items: center; gap: 6px; font-weight: 600; flex: 1; min-width: 0; }
  .perm-label small { color: #64748b; font-size: 9px; display: block; }
  .perm-btn { padding: 7px 12px; font-size: 10px; font-weight: 700; font-family: inherit; border: none; border-radius: 6px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.3px; background: #475569; color: #cbd5e1; min-width: 90px; }
  .perm-btn.on { background: #22c55e; color: #020617; }
  .perm-btn.pending { background: #eab308; color: #020617; }
  .perm-btn.denied { background: #ef4444; color: #ffffff; }
  .perm-btn.unsupported { background: #7f1d1d; color: #fecaca; }
  .perm-btn:active:not(:disabled) { transform: scale(0.96); }
  .perm-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  /* Slayderlar */
  .slider-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-size: 12px; gap: 6px; }
  .slider-row span { min-width: 130px; font-weight: 700; }
  .slider-row input[type="range"] { flex: 1; accent-color: #00f5d4; height: 6px; }
  .slider-row.sim span::after { content: " [SIM]"; color: #64748b; font-size: 9px; font-weight: 400; }

  .btn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 6px; }
  button.action { padding: 11px 6px; font-size: 11px; font-weight: 700; font-family: inherit; border: none; border-radius: 8px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.4px; transition: transform 0.08s, opacity 0.15s; }
  button.action:active:not(:disabled) { transform: scale(0.96); }
  button.action:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-start { background: #00f5d4; color: #020617; }
  .btn-cam   { background: #3b82f6; color: #ffffff; }
  .btn-cam.on{ background: #22c55e; }
  .btn-tg    { background: #eab308; color: #020617; }
  .btn-rec   { background: #f43f5e; color: #ffffff; }
  .btn-reset { background: #475569; color: #ffffff; }

  .tg-inputs { display: flex; gap: 6px; margin-top: 8px; }
  .tg-inputs input { flex: 1; background: #020617; border: 1px solid #334155; color: #38bdf8; padding: 8px; border-radius: 6px; font-size: 11px; font-family: inherit; user-select: text; -webkit-user-select: text; min-width: 0; }

  #logBox { font-size: 11px; color: #4ade80; margin-top: 8px; padding: 8px; background: #020617; border-radius: 6px; line-height: 1.45; word-break: break-word; min-height: 44px; max-height: 140px; overflow-y: auto; border: 1px solid #1e293b; }

  /* Kamera ko'rinishi */
  #camWrap { display: none; width: 100%; max-width: 440px; position: relative; border-radius: 12px; overflow: hidden; border: 2px solid #22c55e; background: #000; }
  #camWrap.show { display: block; }
  #camVideo { width: 100%; display: block; background: #000; }
  #camOverlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none; color: #fff; font-size: 12px; font-weight: 700;
    text-shadow: 0 1px 3px rgba(0,0,0,0.9);
  }
  #camOverlay .pulse-ring {
    width: 80px; height: 80px; border-radius: 50%;
    border: 3px solid rgba(255,255,255,0.6);
    animation: pulse 1.2s ease-out infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.3); opacity: 0; }
  }
  #camQuality {
    position: absolute; bottom: 6px; left: 6px; right: 6px;
    background: rgba(0,0,0,0.7); color: #fff; padding: 4px 8px;
    border-radius: 4px; font-size: 10px; font-weight: 700;
    display: flex; justify-content: space-between;
  }

  #httpsWarn { display: none; background: #7f1d1d; color: #fecaca; padding: 8px 12px; border-radius: 8px; font-size: 11px; width: 100%; max-width: 440px; border: 1px solid #dc2626; }
</style>
</head>
<body>

<div id="httpsWarn">⚠️ <strong>HTTPS kerak!</strong> Kamera va sensorlar faqat <code>https://</code> yoki <code>localhost</code> da ishlaydi.</div>

<div class="monitor-box" id="monBox">
  <canvas id="icuCanvas" width="720" height="680"></canvas>
</div>

<!-- RUXSATLAR -->
<div class="card">
  <div class="card-title">⚙️ Sensor Ruxsatlari (brauzer oynasi ochiladi)</div>

  <div class="perm-row">
    <div class="perm-label">
      <div>📷 Kamera (PPG)<br><small>yurak urishi — flesh + barmoq</small></div>
    </div>
    <button class="perm-btn" id="btnPermCam" type="button">So'rash</button>
  </div>

  <div class="perm-row">
