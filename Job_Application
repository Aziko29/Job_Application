    </div>
    <button class="perm-btn" id="btnPermMotion" type="button">So'rash</button>
  </div>

  <div class="perm-row">
    <div class="perm-label">
      <div>🎤 Mikrofon<br><small>video yozuvga ovoz</small></div>
    </div>
