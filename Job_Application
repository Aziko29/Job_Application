      <div>🔔 Bildirishnoma<br><small>kritik holat ogohlantirish</small></div>
    </div>
    <button class="perm-btn" id="btnPermNotif" type="button">So'rash</button>
  </div>
</div>

<!-- KAMERA KO'RINISHI -->
<div id="camWrap">
  <video id="camVideo" playsinline muted autoplay></video>
  <div id="camOverlay">
    <div class="pulse-ring"></div>
  </div>
  <div id="camQuality">
    <span id="camQualityLeft">Barmoqni kameraga bosing</span>
    <span id="camQualityRight">SQI: --</span>
  </div>
</div>

<!-- BOSHQARUV -->
<div class="card">
  <div class="card-title">🩺 Simulyatsiya (kamera ishlamasa)</div>
  <div class="slider-row sim">
    <span id="lblK" style="color:#00f5d4;">K⁺: 4.2</span>
    <input type="range" id="rngK" min="2.0" max="8.5" step="0.1" value="4.2">
  </div>
  <div class="slider-row sim">
    <span id="lblGlu" style="color:#38bdf8;">Glyukoza: 5.2</span>
    <input type="range" id="rngGlu" min="1.8" max="28.0" step="0.2" value="5.2">
  </div>
  <div class="slider-row sim">
    <span id="lblBpm" style="color:#a7f3d0;">Puls: 75</span>
    <input type="range" id="rngBpm" min="45" max="175" step="1" value="75">
  </div>

  <div class="btn-grid">
    <button class="action btn-start" id="btnAudio" type="button">🔊 Ovoz Yoqish</button>
    <button class="action btn-cam"   id="btnCamToggle" type="button">📷 Kamera Puls</button>
    <button class="action btn-rec"   id="btnRec" type="button">🎬 6s Video</button>
    <button class="action btn-reset" id="btnReset" type="button">🔄 Tiklash</button>
  </div>
</div>

<!-- TELEGRAM -->
<div class="card">
  <div class="card-title">✈️ Telegram Bot</div>
  <div class="tg-inputs">
    <input type="text" id="botToken" placeholder="Bot Token">
    <input type="text" id="chatId"   placeholder="Chat ID">
  </div>
  <div class="btn-grid">
    <button class="action btn-tg" id="btnTg" type="button">✈️ Xabar Yuborish</button>
    <button class="action btn-reset" id="btnStatus" type="button">📊 Sensor Holati</button>
  </div>
  <div id="logBox">> Tizim tayyor. Yuqoridagi "So'rash" tugmalaridan birini bosing.</div>
</div>

<script>
(function () {
  "use strict";

  // ============================================================
  // HTTPS tekshiruvi
  // ============================================================
  if (location.protocol !== 'https:' && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
    document.getElementById('httpsWarn').style.display = 'block';
  }

  // ============================================================
  // Yordamchilar
  // ============================================================
  const U = {
    mean: a => a.length ? a.reduce((x,y)=>x+y,0)/a.length : 0,
    std: a => { if (!a.length) return 0; const m = U.mean(a); return Math.sqrt(a.reduce((x,y)=>x+(y-m)*(y-m),0)/a.length); },
    median: a => { if (!a.length) return 0; const s = [...a].sort((x,y)=>x-y); const m = Math.floor(s.length/2); return s.length%2 ? s[m] : (s[m-1]+s[m])/2; },
    clamp: (v,lo,hi) => Math.max(lo, Math.min(hi, v)),
    // Moving average detrending
    detrend(arr, win) {
      const n = arr.length;
      const out = new Array(n);
      for (let i = 0; i < n; i++) {
        const lo = Math.max(0, i - win);
        const hi = Math.min(n, i + win + 1);
        let s = 0;
        for (let j = lo; j < hi; j++) s += arr[j];
        out[i] = arr[i] - s / (hi - lo);
      }
      return out;
    },
    // Peak detection: returns indices of peaks
    detectPeaks(sig, minDistSamples, thresholdFactor) {
      const absMax = sig.reduce((m,x)=>Math.max(m,Math.abs(x)),0);
      if (absMax < 1e-9) return [];
      const th = absMax * (thresholdFactor || 0.3);
      const peaks = [];
      let lastIdx = -minDistSamples;
      for (let i = 1; i < sig.length - 1; i++) {
        if (sig[i] > sig[i-1] && sig[i] > sig[i+1] && sig[i] > th) {
          if (i - lastIdx >= minDistSamples) {
            peaks.push(i);
            lastIdx = i;
          }
        }
      }
      return peaks;
    }
  };

  // ============================================================
  // DOM
  // ============================================================
  const canvas  = document.getElementById('icuCanvas');
  const ctx     = canvas.getContext('2d');
  const monBox  = document.getElementById('monBox');
  const logBox  = document.getElementById('logBox');
  const videoEl = document.getElementById('camVideo');
  const camWrap = document.getElementById('camWrap');
  const camQualityL = document.getElementById('camQualityLeft');
  const camQualityR = document.getElementById('camQualityRight');

  const W = canvas.width, H = canvas.height;

  const rngK   = document.getElementById('rngK');
  const rngGlu = document.getElementById('rngGlu');
  const rngBpm = document.getElementById('rngBpm');
  const lblK   = document.getElementById('lblK');
  const lblGlu = document.getElementById('lblGlu');
  const lblBpm = document.getElementById('lblBpm');

  const btnPermCam   = document.getElementById('btnPermCam');
  const btnPermMotion= document.getElementById('btnPermMotion');
  const btnPermMic   = document.getElementById('btnPermMic');
  const btnPermNotif = document.getElementById('btnPermNotif');

  const btnAudio  = document.getElementById('btnAudio');
  const btnCamT   = document.getElementById('btnCamToggle');
  const btnRec    = document.getElementById('btnRec');
  const btnReset  = document.getElementById('btnReset');
  const btnTg     = document.getElementById('btnTg');
  const btnStatus = document.getElementById('btnStatus');

  function log(m) { logBox.textContent = m; try { console.log('[TIBEX]', m); } catch(e){} }
  function setPermBtn(btn, state, txt) {
    btn.className = 'perm-btn' + (state ? ' ' + state : '');
    btn.textContent = txt;
  }

  // ============================================================
  // GLOBAL STATE
  // ============================================================
  const S = {
    // streams
    camStream: null, micStream: null,
    camActive: false, motionActive: false,
    // audio
    audioCtx: null, masterGain: null, streamDest: null, soundOn: false,
    // ppg
    ppg: { samples: [], bpm: 0, quality: 0, lastBeat: 0, lastAnalyze: 0 },
    // motion
    motion: { samples: [], resp: 0, motionLevel: 0, lastAnalyze: 0 },
    // manual sliders
    k: 4.2, glu: 5.2, bpmManual: 75,
    // display
    activeBpm: 75, activeBpmSrc: 'sim',
    activeResp: 0, activeRespSrc: '--',
    // canvas buffers
    ecg: new Float32Array(W),
    ppgBuf: new Float32Array(W),
    accBuf: new Float32Array(W),
    phase: 0, prevPhase: 0,
    lastTs: 0, lastFrame: 0,
    // notifications
    notifLast: 0,
    // help counters
    camStartTs: 0
  };

  // ============================================================
  // RUXSATLAR — har biri mustaqil brauzer oynasini ochadi
  // ============================================================

  // --- KAMERA ---
  btnPermCam.addEventListener('click', async () => {
    if (S.camStream) {
      // allaqachon ochilgan - o'chirish
      S.camStream.getTracks().forEach(t => t.stop());
      S.camStream = null;
      S.camActive = false;
      videoEl.srcObject = null;
      camWrap.classList.remove('show');
      btnCamT.classList.remove('on');
      btnCamT.textContent = '📷 Kamera Puls';
      setPermBtn(btnPermCam, '', 'Qayta ochish');
      log('Kamera yopildi.');
      return;
    }

    setPermBtn(btnPermCam, 'pending', 'Kutilmoqda...');
    log('📷 Brauzer kamera ruxsat oynasini ochdi...');

    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: {
          facingMode: 'environment',
          width: { ideal: 320 },
          height: { ideal: 320 },
          frameRate: { ideal: 30 }
        },
        audio: false
      });

      S.camStream = stream;
      videoEl.srcObject = stream;
      await videoEl.play().catch(() => {});

      // Flesh (torch)
      const track = stream.getVideoTracks()[0];
      if (track && track.applyConstraints) {
        try {
          await track.applyConstraints({ advanced: [{ torch: true }] });
          log('✅ Kamera + flesh yoqildi. Barmog\'ingizni orqa kameraga qo\'ying.');
        } catch (e) {
          log('✅ Kamera yoqildi (flesh qo\'llab-quvvatlanmadi). Barmoqni bosing.');
        }
      }

      camWrap.classList.add('show');
      btnCamT.classList.add('on');
      btnCamT.textContent = '🔴 Kamerani O\'chirish';
      setPermBtn(btnPermCam, 'on', '✓ Ruxsat berildi');
      S.camActive = true;
      S.camStartTs = performance.now();
      S.ppg.samples = [];
      S.ppg.bpm = 0;
      S.ppg.quality = 0;
      S.ppg.lastBeat = 0;

    } catch (err) {
      setPermBtn(btnPermCam, 'denied', '✗ Rad etildi');
      log('❌ Kamera rad etildi: ' + (err.name || '') + ' — ' + (err.message || err));
    }
  });

  // --- MOTION (Akselerometr + Gyroskop) ---
  btnPermMotion.addEventListener('click', async () => {
    if (S.motionActive) {
      stopMotion();
      setPermBtn(btnPermMotion, '', 'Qayta yoqish');
      return;
    }

    setPermBtn(btnPermMotion, 'pending', 'Kutilmoqda...');

    // iOS 13+ ruxsat so'rovi — sinxron tarzda, foydalanuvchi bosishiga javoban
    if (typeof DeviceMotionEvent === 'undefined') {
      setPermBtn(btnPermMotion, 'unsupported', 'Qo\'llanmaydi');
      log('❌ Bu qurilma/brauzer DeviceMotion sensorini qo\'llab-quvvatlamaydi.');
      return;
    }

    let granted = true;
    if (typeof DeviceMotionEvent.requestPermission === 'function') {
      // iOS
      try {
        log('📱 iOS ruxsat oynasi ochilmoqda...');
        const res = await DeviceMotionEvent.requestPermission();
        granted = res === 'granted';
        if (!granted) {
          setPermBtn(btnPermMotion, 'denied', '✗ Rad etildi');
          log('❌ Harakat sensori rad etildi.');
          return;
        }
      } catch (err) {
        setPermBtn(btnPermMotion, 'denied', '✗ Xato');
        log('❌ Sensor ruxsat xatosi: ' + err.message);
        return;
      }
    }

    // Android yoki ruxsat berilgan iOS
    startMotion();
    setPermBtn(btnPermMotion, 'on', '✓ Faol');
    log('✅ Akselerometr + gyroskop faol. Nafas olish o\'lchanadi.');
  });

  function startMotion() {
    S.motionActive = true;
    S.motion.samples = [];
    window.addEventListener('devicemotion', onDeviceMotion, { passive: true });
  }

  function stopMotion() {
    S.motionActive = false;
    window.removeEventListener('devicemotion', onDeviceMotion);
    S.motion.samples = [];
    S.motion.resp = 0;
    S.motion.motionLevel = 0;
    log('Harakat sensori to\'xtatildi.');
  }

  function onDeviceMotion(ev) {
    const t = performance.now();
    const acc = ev.accelerationIncludingGravity || ev.acceleration;
    if (!acc) return;

    const x = acc.x || 0, y = acc.y || 0, z = acc.z || 0;
    const rot = ev.rotationRate || {};
    const mag = Math.sqrt(x*x + y*y + z*z);

    const buf = S.motion.samples;
    buf.push({ t, x, y, z, mag, gx: rot.alpha||0, gy: rot.beta||0, gz: rot.gamma||0 });
    const cutoff = t - 15000;
    while (buf.length && buf[0].t < cutoff) buf.shift();
  }

  // --- MIKROFON ---
  btnPermMic.addEventListener('click', async () => {
    if (S.micStream) {
      S.micStream.getTracks().forEach(t => t.stop());
      S.micStream = null;
      setPermBtn(btnPermMic, '', 'Qayta ochish');
      log('Mikrofon yopildi.');
      return;
    }
    setPermBtn(btnPermMic, 'pending', 'Kutilmoqda...');
    log('🎤 Brauzer mikrofon ruxsat oynasini ochdi...');
    try {
      S.micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      setPermBtn(btnPermMic, 'on', '✓ Faol');
      log('✅ Mikrofon faol. Video yozuvga ovoz qo\'shiladi.');
    } catch (err) {
      setPermBtn(btnPermMic, 'denied', '✗ Rad etildi');
      log('❌ Mikrofon rad etildi: ' + err.message);
    }
  });

  // --- BILDIRISHNOMA ---
  btnPermNotif.addEventListener('click', async () => {
    if (!('Notification' in window)) {
      setPermBtn(btnPermNotif, 'unsupported', 'Qo\'llanmaydi');
      log('❌ Bildirishnoma API mavjud emas.');
      return;
    }
    if (Notification.permission === 'granted') {
      setPermBtn(btnPermNotif, 'on', '✓ Faol');
      log('Bildirishnoma allaqachon yoqilgan.');
      return;
    }
    setPermBtn(btnPermNotif, 'pending', 'Kutilmoqda...');
    try {
      const p = await Notification.requestPermission();
      if (p === 'granted') {
        setPermBtn(btnPermNotif, 'on', '✓ Faol');
        log('✅ Bildirishnoma faol.');
        try {
          new Notification('TIBEX ICU', { body: 'Bildirishnoma tizimi tayyor!', tag: 'tibex-hello' });
        } catch (e) {}
      } else {
        setPermBtn(btnPermNotif, 'denied', '✗ Rad etildi');
        log('❌ Bildirishnoma rad etildi: ' + p);
      }
    } catch (err) {
      setPermBtn(btnPermNotif, 'denied', '✗ Xato');
      log('❌ Xato: ' + err.message);
    }
  });

  // ============================================================
  // PPG ANALIZ (kamera → yurak urishi)
  // ============================================================
  const tmpCanvas = document.createElement('canvas');
  tmpCanvas.width = 32; tmpCanvas.height = 32;
  const tmpCtx = tmpCanvas.getContext('2d', { willReadFrequently: true });
  let lastCamRead = 0;

  function readCameraSample(now) {
    // 30 ms dan tez o'qimaymiz (kamera ~30 fps)
    if (now - lastCamRead < 30) return null;
    lastCamRead = now;
    if (!S.camActive || videoEl.readyState < 2) return null;
    if (!videoEl.videoWidth) return null;

    tmpCtx.drawImage(videoEl, 0, 0, 32, 32);
    const d = tmpCtx.getImageData(0, 0, 32, 32).data;
    let sumR = 0, sumG = 0, sumB = 0;
    for (let i = 0; i < d.length; i += 4) {
      sumR += d[i]; sumG += d[i+1]; sumB += d[i+2];
    }
    const N = 1024;
    const r = sumR/N, g = sumG/N, b = sumB/N;

    // Perfuziya signali: qizil dominant, yashil-fon
    // (R - G) normalizatsiya bilan yorug'likka chidamli
    const denom = r + g + b + 1;
    const perfusion = (r - g) / denom * 1000;

    return { t: now, r, g, b, perfusion };
  }

  function analyzePPG() {
    const buf = S.ppg.samples;
    if (buf.length < 60) return;

    const vals = buf.map(s => s.perfusion);
    const times = buf.map(s => s.t);

    // 1) Detrend (sliding mean, ~15 sample)
    const win = Math.min(15, Math.floor(vals.length / 4));
    const detrended = U.detrend(vals, win);

    // 2) Peak detection — min 250 ms interval (240 BPM max)
    const avgDt = (times[times.length-1] - times[0]) / (times.length - 1);
    const minSamples = Math.max(2, Math.round(250 / avgDt));
    const peaks = U.detectPeaks(detrended, minSamples, 0.30);

    if (peaks.length < 3) {
      S.ppg.bpm = 0;
      S.ppg.quality = 0;
      return;
    }

    // 3) RR intervals
    const rr = [];
    for (let i = 1; i < peaks.length; i++) {
      rr.push(times[peaks[i]] - times[peaks[i-1]]);
    }
    const med = U.median(rr);
    const good = rr.filter(x => Math.abs(x - med) < med * 0.4);

    if (good.length < 2) {
      S.ppg.bpm = 0;
      S.ppg.quality = 0;
      return;
    }

    const cleanMean = U.mean(good);
    const bpm = 60000 / cleanMean;

    // 4) Sifat indeksi
    let q = Math.round(good.length / rr.length * 100);
    // Interval barqarorligi
    const sd = U.std(good);
    const cv = sd / cleanMean;
    if (cv < 0.05) q = Math.min(100, q + 15);
    else if (cv > 0.20) q = Math.max(0, q - 20);

    // 5) Sanity check
    if (bpm < 35 || bpm > 210) { S.ppg.bpm = 0; S.ppg.quality = 0; return; }

    // Smoothing (median of last 3)
    S.ppg.bpm = S.ppg.bpm ? Math.round((S.ppg.bpm + bpm + bpm) / 3) : Math.round(bpm);
    S.ppg.quality = q;
  }

  // ============================================================
  // MOTION ANALIZ (akselerometr → nafas + harakat)
  // ============================================================
  function analyzeMotion() {
    const buf = S.motion.samples;
    if (buf.length < 60) return;

    // Harakat darajasi — yuqori chastotali tebranish
    const mags = buf.map(s => s.mag);
    const mean = U.mean(mags);
    const variance = U.mean(mags.map(m => (m - mean) * (m - mean)));
    S.motion.motionLevel = U.clamp(variance * 100, 0, 100);

    // Nafas olish — 0.1–0.5 Hz
    // 5+ sekund ma'lumot kerak
    if (buf.length < 200) { S.motion.resp = 0; return; }

    const detrended = U.detrend(mags, 90); // ~1.5s oyna

    // Past chastotali komponenta (nafas signali)
    // 90-sample oyna bilan detrending yuqori chastotani olib tashlaydi
    const smooth = [];
    const smoothWin = 15;
    for (let i = 0; i < detrended.length; i++) {
      const lo = Math.max(0, i - smoothWin);
      const hi = Math.min(detrended.length, i + smoothWin + 1);
      let s = 0;
      for (let j = lo; j < hi; j++) s += detrended[j];
      smooth.push(s / (hi - lo));
    }

    // Peak detection (nafas cho'qqilari)
    const avgDt = (buf[buf.length-1].t - buf[0].t) / (buf.length - 1);
    const minSamples = Math.max(2, Math.round(1500 / avgDt)); // 40/min max
    const peaks = U.detectPeaks(smooth, minSamples, 0.20);

    if (peaks.length < 2) { S.motion.resp = 0; return; }

    const duration = (buf[buf.length-1].t - buf[0].t) / 1000;
    const rate = peaks.length / duration * 60;

    if (rate > 5 && rate < 40) {
      S.motion.resp = Math.round(rate);
    } else {
      S.motion.resp = 0;
    }
  }

  // ============================================================
  // OVOZ
  // ============================================================
  function initAudio() {
    if (!S.audioCtx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) { log('⚠️ Web Audio yo\'q.'); return; }
      S.audioCtx = new AC();
      S.masterGain = S.audioCtx.createGain();
      S.masterGain.gain.value = 0.85;
      S.masterGain.connect(S.audioCtx.destination);
      if (S.audioCtx.createMediaStreamDestination) {
        S.streamDest = S.audioCtx.createMediaStreamDestination();
        S.masterGain.connect(S.streamDest);
      }
    }
    if (S.audioCtx.state === 'suspended') S.audioCtx.resume();
    S.soundOn = !S.soundOn;
    btnAudio.textContent = S.soundOn ? '🔊 Ovoz: YOQILGAN' : '🔇 Ovoz: O\'CHIQ';
    btnAudio.style.background = S.soundOn ? '#22c55e' : '#00f5d4';
    log(S.soundOn ? 'Ovoz faol.' : 'Ovoz o\'chirildi.');
  }

  function beep(crit) {
    if (!S.soundOn || !S.audioCtx) return;
    const now = S.audioCtx.currentTime;
    const osc = S.audioCtx.createOscillator();
    const g = S.audioCtx.createGain();
    osc.type = crit ? 'sawtooth' : 'sine';
    osc.frequency.setValueAtTime(crit ? 1280 : 900, now);
    if (crit) osc.frequency.exponentialRampToValueAtTime(600, now + 0.08);
    g.gain.setValueAtTime(crit ? 0.30 : 0.18, now);
    g.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
    osc.connect(g); g.connect(S.masterGain);
    osc.start(now); osc.stop(now + 0.085);
  }

  // ============================================================
  // EKG MODELI (K⁺ ga bog'langan)
  // ============================================================
  function computeEcg(p, k) {
    const pF = Math.max(0.02, 0.15 - Math.max(0, k - 5.2) * 0.04);
    const pW = pF * Math.exp(-Math.pow(p - 0.18, 2) / (2 * 0.024*0.024));
    const qW = -0.17 * Math.exp(-Math.pow(p - 0.35, 2) / (2 * 0.008*0.008));
    const rW = 1.05 * Math.exp(-Math.pow(p - 0.40, 2) / (2 * 0.011*0.011));
    const sW = -0.32 * Math.exp(-Math.pow(p - 0.45, 2) / (2 * 0.011*0.011));
    const tA = 0.22 + Math.max(0, (k - 4.0) * 0.22);
    const tW = Math.max(0.016, 0.042 - Math.max(0, (k - 4.5) * 0.007));
    const tWave = tA * Math.exp(-Math.pow(p - 0.66, 2) / (2 * tW*tW));
    return pW + qW + rW + sW + tWave;
  }

  function computePleth(p) {
    const sys = 0.72 * Math.exp(-Math.pow(p - 0.48, 2) / (2 * 0.055*0.055));
    const dic = 0.32 * Math.exp(-Math.pow(p - 0.68, 2) / (2 * 0.065*0.065));
    return sys + dic - 0.24;
  }

