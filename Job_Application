    // Motion mavjudligini tekshirish
    if (typeof DeviceMotionEvent === 'undefined') {
      setPermBtn(btnPermMotion, 'unsupported', 'Qo\'llanmaydi');
    } else if (typeof DeviceMotionEvent.requestPermission !== 'function') {
      setPermBtn(btnPermMotion, '', 'Yoqish');
    } else {
      setPermBtn(btnPermMotion, '', 'So\'rash');
    }

    updateSliders();
    requestAnimationFrame(render);
  })();

})();
</script>
</body>
</html>