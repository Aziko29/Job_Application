    lblGlu.textContent = 'Glyukoza: ' + S.glu.toFixed(1);
    lblGlu.style.color = critG ? '#ff0055' : '#38bdf8';

    lblBpm.textContent = 'Puls: ' + S.bpmManual;
    lblBpm.style.color = critH ? '#ff0055' : '#a7f3d0';
  }
